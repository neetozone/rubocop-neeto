# Settings for Dockerfile.neetodeploy. This folder belongs to the app:
# It was copied from the Neeto products, not generated by neeto-commons-backend.
#
# No package.json build: this app has no JavaScript.
YARN_BUILD=false
# No `rails assets:precompile`: this gem serves its YARD docs, it is not a Rails app.
ASSETS_PRECOMPILE=false
